# Compile the CURRENT renderer math into a CPU-only oracle with tiny test stubs.
# No copied production formulas, extra shader compiler, GL or engine linkage.
set(DECODE_BSP "${CMAKE_CURRENT_SOURCE_DIR}/../../shared/rd-rend2/tr_bsp.cpp")
set(DECODE_MATH "${CMAKE_CURRENT_SOURCE_DIR}/../../shared/rd-rend2/tr_extramath.h")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${DECODE_BSP}" "${DECODE_MATH}")
file(READ "${DECODE_BSP}" DECODE_SOURCE)
string(FIND "${DECODE_SOURCE}" "static\tvoid R_ColorShiftLightingBytes(" DECODE_START)
string(FIND "${DECODE_SOURCE}" "void ColorToRGBA16F(" DECODE_END)
if(DECODE_START LESS 0 OR DECODE_END LESS DECODE_START)
	message(FATAL_ERROR "Renderer decode oracle boundaries changed; review the reference extraction")
endif()
math(EXPR DECODE_LENGTH "${DECODE_END} - ${DECODE_START}")
string(SUBSTRING "${DECODE_SOURCE}" ${DECODE_START} ${DECODE_LENGTH} DECODE_FUNCTIONS)
string(FIND "${DECODE_SOURCE}" "//hack: convert LDR lightmap to HDR one" DECODE_START)
if(DECODE_START LESS 0)
	message(FATAL_ERROR "Renderer LDR float-lightmap path changed; review the reference extraction")
endif()
string(SUBSTRING "${DECODE_SOURCE}" ${DECODE_START} -1 DECODE_TAIL)
set(DECODE_STOP "R_LinearizeLightingColor(color);")
string(FIND "${DECODE_TAIL}" "${DECODE_STOP}" DECODE_END)
if(DECODE_END LESS 0)
	message(FATAL_ERROR "Renderer LDR linearization path changed; review the reference extraction")
endif()
string(LENGTH "${DECODE_STOP}" DECODE_STOP_LENGTH)
math(EXPR DECODE_LENGTH "${DECODE_END} + ${DECODE_STOP_LENGTH}")
string(SUBSTRING "${DECODE_TAIL}" 0 ${DECODE_LENGTH} DECODE_LDR)
file(READ "${DECODE_MATH}" DECODE_MATH_SOURCE)
string(REGEX MATCH "#define sRGBtoRGB[^\n]+" DECODE_SRGB "${DECODE_MATH_SOURCE}")
if(NOT DECODE_SRGB)
	message(FATAL_ERROR "Renderer sRGB macro changed; review the reference extraction")
endif()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/decode_renderer_reference.h"
"// Generated from current tr_bsp.cpp/tr_extramath.h, included inside test namespace.\n${DECODE_SRGB}\n${DECODE_FUNCTIONS}\nvoid LdrFloat(byte* buf_p, float* color) { int j = 0, numColorComponents = 3;\n${DECODE_LDR}\n}\n")

# The grid direction oracle also compiles the actual legacy decode/table code.
set(GRID_LIGHT "${CMAKE_CURRENT_SOURCE_DIR}/../../shared/rd-rend2/tr_light.cpp")
set(GRID_LOCAL "${CMAKE_CURRENT_SOURCE_DIR}/../../shared/rd-rend2/tr_local.h")
set(GRID_MATH "${CMAKE_CURRENT_SOURCE_DIR}/../../shared/qcommon/q_math.h")
set(GRID_SP_INIT "${CMAKE_CURRENT_SOURCE_DIR}/../../code/rd-rend2/tr_init.cpp")
set(GRID_MP_INIT "${CMAKE_CURRENT_SOURCE_DIR}/../../codemp/rd-rend2/tr_init.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${GRID_LIGHT}" "${GRID_LOCAL}" "${GRID_MATH}" "${GRID_SP_INIT}" "${GRID_MP_INIT}")
file(READ "${GRID_LIGHT}" GRID_SOURCE)
string(FIND "${GRID_SOURCE}" "lat = data->latLong[1];" GRID_START)
string(FIND "${GRID_SOURCE}" "VectorMA( direction, factor, normal, direction );" GRID_END)
if(GRID_START LESS 0 OR GRID_END LESS GRID_START)
	message(FATAL_ERROR "Entity grid direction oracle boundaries changed; review extraction")
endif()
math(EXPR GRID_LENGTH "${GRID_END} - ${GRID_START}")
string(SUBSTRING "${GRID_SOURCE}" ${GRID_START} ${GRID_LENGTH} GRID_DECODE)
file(READ "${GRID_LOCAL}" GRID_SOURCE)
string(REGEX MATCH "#define FUNCTABLE_SIZE[^\n]+" GRID_SIZE "${GRID_SOURCE}")
string(REGEX MATCH "#define FUNCTABLE_MASK[^\n]+" GRID_MASK "${GRID_SOURCE}")
file(READ "${GRID_MATH}" GRID_SOURCE)
string(REGEX MATCH "#define PI_DIV_180[^\n]+" GRID_PI "${GRID_SOURCE}")
string(REGEX MATCH "#define DEG2RAD[^\n]+" GRID_DEG "${GRID_SOURCE}")
file(READ "${GRID_SP_INIT}" GRID_SOURCE)
string(REGEX MATCH "tr.sinTable\\[i\\][^\n]+" GRID_TABLE "${GRID_SOURCE}")
file(READ "${GRID_MP_INIT}" GRID_SOURCE)
string(REGEX MATCH "tr.sinTable\\[i\\][^\n]+" GRID_MP_TABLE "${GRID_SOURCE}")
if(NOT GRID_SIZE OR NOT GRID_MASK OR NOT GRID_PI OR NOT GRID_DEG OR NOT GRID_TABLE OR NOT GRID_TABLE STREQUAL GRID_MP_TABLE)
	message(FATAL_ERROR "SP/MP grid table definitions changed; review direction convention")
endif()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/grid_renderer_reference.h"
"// Generated from current SP/MP renderer math. Test-only stubs, no engine/GL.\nnamespace GridReference {\n${GRID_SIZE}\n${GRID_MASK}\n${GRID_PI}\n${GRID_DEG}\nstruct Tables { float sinTable[FUNCTABLE_SIZE]; Tables() { auto& tr=*this; for(int i=0;i<FUNCTABLE_SIZE;++i) { ${GRID_TABLE} } } };\ninline void Decode(const uint8_t bytes[2],float out[3]) { static const Tables tr; struct Cell { uint8_t latLong[2]; } cell={{bytes[0],bytes[1]}}; const Cell* data=&cell; int lat,lng; float normal[3];\n${GRID_DECODE}\nfloat n=std::sqrt(normal[0]*normal[0]+normal[1]*normal[1]+normal[2]*normal[2]); for(int i=0;i<3;++i) out[i]=normal[i]/n; }\n#undef FUNCTABLE_SIZE\n#undef FUNCTABLE_MASK\n#undef PI_DIV_180\n#undef DEG2RAD\n}\n")
