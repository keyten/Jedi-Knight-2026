			action 
			{ 
				play			"sound/interface/button1.wav" ; 
				uiScript		closeingame			// Close menu				
			}
		}


	itemDef { name render2026 rect 40 395 180 19
      type 1 style 0 visible 1 font 4 textscale 0.8
      textalign 0 textalignx 0 textaligny 0
      forecolor 0.72 0.82 1 1 text "RENDER 2026" action { close all ; open render2026_0 ; } }
}
menuDef { name render2026_0 fullScreen 1 visible 0 rect 0 0 640 480
          style 1 backcolor 0.025 0.04 0.075 1 focusColor 1 0.72 0.25 1
          descX 320 descY 407 descScale 0.65 descColor 0.85 0.85 0.85 1 descAlignment 1
          onESC { close all ; open ingameMainMenu ; }
          onOpen { setfocus setting_0 ; }
itemDef { name title rect 28 23 590 19
      type 0 style 0 visible 1 font 4 textscale 0.8
      textalign 0 textalignx 0 textaligny 0
      forecolor 0.72 0.82 1 1 text "RENDER 2026 | Pipeline prerequisites" decoration }
itemDef { name hint rect 28 48 590 19
      type 0 style 0 visible 1 font 4 textscale 0.8
      textalign 0 textalignx 0 textaligny 0
      forecolor 0.72 0.82 1 1 text "Page 1/24  |  * = renderer restart / reload required" decoration }
itemDef { name setting_0 rect 26 82 586 19
      type 9 style 0 visible 1 font 4 textscale 0.8
      textalign 2 textalignx 330 textaligny 0
      forecolor 0.72 0.82 1 1 text "hdr *" cvar "r_hdr" descText "HDR: Disable/enable rendering in HDR" maxChars 128 maxPaintChars 20 }
