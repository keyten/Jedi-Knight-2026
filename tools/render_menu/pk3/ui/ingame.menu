itemDef { name setting_0 rect 26 82 586 19
      type 12 style 0 visible 1 font 4 textscale 0.8
      textalign 2 textalignx 330 textaligny 0
      forecolor 0.72 0.82 1 1 text "tone Map Mode" cvar "r_toneMapMode" descText "Tone mapping: 0 legacy Rend2 filmic, 1 ACES fitted, 2 AgX-like." cvarFloatList { "Legacy" 0 "ACES" 1 "AgX-like" 2 } }
