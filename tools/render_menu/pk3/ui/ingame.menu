      type 9 style 0 visible 1 font 4 textscale 0.8
      textalign 2 textalignx 330 textaligny 0
      forecolor 0.72 0.82 1 1 text "tone Map *" cvar "r_toneMap" descText "Tone mapping: Disable/enable tonemapping" maxChars 128 maxPaintChars 20 }
