      type 9 style 0 visible 1 font 4 textscale 0.8
      textalign 2 textalignx 330 textaligny 0
      forecolor 0.72 0.82 1 1 text "auto Exposure" cvar "r_autoExposure" descText "Auto exposure: Disable/enable auto exposure" maxChars 128 maxPaintChars 20 }
itemDef { name setting_3 rect 26 151 586 19
      type 9 style 0 visible 1 font 4 textscale 0.8
      textalign 2 textalignx 330 textaligny 0
