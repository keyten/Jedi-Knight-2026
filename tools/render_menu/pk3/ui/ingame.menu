	itemDef { name render2026 rect 40 395 180 19
      type ITEM_TYPE_BUTTON style WINDOW_STYLE_EMPTY visible 1 font 4 textscale 0.8
      textalign ITEM_ALIGN_LEFT textalignx 0 textaligny 0
      forecolor 0.72 0.82 1 1 text "RENDER 2026" action { close all ; open render2026_0 ; } }
}
menuDef { name render2026_0 fullScreen 0 visible 0 rect 0 0 640 480
          style WINDOW_STYLE_EMPTY focusColor 1 0.75 0.3 1
          descX 440 descY 382 descScale 0.55 descColor 0.85 0.9 1 1 descAlignment ITEM_ALIGN_CENTER
          onOpen { setcvar cl_paused 0 ; uiScript renderSettingsBegin ; setfocus setting_0 ; }
          onESC { uiScript closeingame ; }
          itemDef { name panel rect 236 10 400 460 style WINDOW_STYLE_FILLED
            backcolor 0.025 0.04 0.07 0.82 visible 1 decoration }
          itemDef { name title rect 252 26 376 19
      type ITEM_TYPE_TEXT style WINDOW_STYLE_EMPTY visible 1 font 4 textscale 0.85
      textalign ITEM_ALIGN_LEFT textalignx 0 textaligny 0
      forecolor 0.72 0.82 1 1 text "RENDER 2026" decoration }
 itemDef { name subtitle rect 252 50 376 19
      type ITEM_TYPE_TEXT style WINDOW_STYLE_EMPTY visible 1 font 4 textscale 0.65
      textalign ITEM_ALIGN_LEFT textalignx 0 textaligny 0
      forecolor 0.72 0.82 1 1 text "Live rendering controls | game keeps running" decoration }

