itemDef { name setting_6 rect 26 220 586 19
      type 9 style 0 visible 1 font 4 textscale 0.8
      textalign 2 textalignx 330 textaligny 0
      forecolor 0.72 0.82 1 1 text "parallax Mapping" cvar "r_parallaxMapping" descText "Parallax mapping: Disable/enable parallax mapping" maxChars 128 maxPaintChars 20 }
itemDef { name setting_7 rect 26 243 586 19
      type 9 style 0 visible 1 font 4 textscale 0.8
      textalign 2 textalignx 330 textaligny 0
      forecolor 0.72 0.82 1 1 text "sunlight Mode *" cvar "r_sunlightMode" descText "Realtime sunlight: " maxChars 128 maxPaintChars 20 }
itemDef { name setting_8 rect 26 266 586 19
      type 9 style 0 visible 1 font 4 textscale 0.8
      textalign 2 textalignx 330 textaligny 0
      forecolor 0.72 0.82 1 1 text "dlight Mode *" cvar "r_dlightMode" descText "Dynamic lighting: " maxChars 128 maxPaintChars 20 }
itemDef { name setting_9 rect 26 289 586 19
      type 9 style 0 visible 1 font 4 textscale 0.8
      textalign 2 textalignx 330 textaligny 0
      forecolor 0.72 0.82 1 1 text "cube Mapping *" cvar "r_cubeMapping" descText "Cubemap reflections: Disable/enable cubemapping" maxChars 128 maxPaintChars 20 }
itemDef { name previous rect 28 444 95 19
      type 1 style 0 visible 1 font 4 textscale 0.8
      textalign 0 textalignx 0 textaligny 0
      forecolor 0.72 0.82 1 1 text "< PREV" action { close render2026_0 ; open render2026_23 ; } }
itemDef { name next rect 145 444 95 19
      type 1 style 0 visible 1 font 4 textscale 0.8
      textalign 0 textalignx 0 textaligny 0
      forecolor 0.72 0.82 1 1 text "NEXT >" action { close render2026_0 ; open render2026_1 ; } }
itemDef { name apply rect 270 444 175 19
      type 1 style 0 visible 1 font 4 textscale 0.8
      textalign 0 textalignx 0 textaligny 0
      forecolor 0.72 0.82 1 1 text "APPLY / RESTART" action { uiScript closeingame ; exec "vid_restart" ; } }
itemDef { name back rect 524 444 88 19
      type 1 style 0 visible 1 font 4 textscale 0.8
      textalign 0 textalignx 0 textaligny 0
      forecolor 0.72 0.82 1 1 text "BACK" action { close all ; open ingameMainMenu ; } }
}
menuDef { name render2026_1 fullScreen 1 visible 0 rect 0 0 640 480
          style 1 backcolor 0.025 0.04 0.075 1 focusColor 1 0.72 0.25 1
          descX 320 descY 407 descScale 0.65 descColor 0.85 0.85 0.85 1 descAlignment 1
          onESC { close all ; open ingameMainMenu ; }
          onOpen { setfocus setting_0 ; }
itemDef { name title rect 28 23 590 19
      type 0 style 0 visible 1 font 4 textscale 0.8
      textalign 0 textalignx 0 textaligny 0
      forecolor 0.72 0.82 1 1 text "RENDER 2026 | Colors & post-processing" decoration }
itemDef { name hint rect 28 48 590 19
