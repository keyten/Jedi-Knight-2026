itemDef { name contents rect 320 443 90 19
      type ITEM_TYPE_BUTTON style WINDOW_STYLE_EMPTY visible 1 font 4 textscale 0.65
      textalign ITEM_ALIGN_LEFT textalignx 0 textaligny 0
      forecolor 0.72 0.82 1 1 text "CONTENTS" action { close all ; open render2026_0 ; } }
itemDef { name apply rect 422 443 150 19
      type ITEM_TYPE_BUTTON style WINDOW_STYLE_EMPTY visible 1 font 4 textscale 0.65
      textalign ITEM_ALIGN_LEFT textalignx 0 textaligny 0
      forecolor 0.72 0.82 1 1 text "APPLY / RESTART" cvarTest ui_r2026_restartPending enableCvar { "1" } action { uiScript closeingame ; exec "vid_restart" ; } }
itemDef { name close rect 580 443 52 19
      type ITEM_TYPE_BUTTON style WINDOW_STYLE_EMPTY visible 1 font 4 textscale 0.65
      textalign ITEM_ALIGN_LEFT textalignx 0 textaligny 0
      forecolor 0.72 0.82 1 1 text "CLOSE" action { uiScript closeingame ; } }
}
